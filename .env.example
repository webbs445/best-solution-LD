# Copy to .env.local and fill in before going live.

# ANSHAD: ERPNext connection for calculator leads (creates a Lead via /api/resource/Lead).
# Server-only: the browser posts to /api/lead and these values are never exposed to visitors.
# Leave any of the three empty and the form shows a "not connected yet" message instead of sending.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional Lead Source override. Must already exist in the ERP's "Lead Source" list. Empty = Website.
ERPNEXT_LEAD_SOURCE=

# Google Ads lead import: the CSV at /api/ads-conversions (Google Ads > Goals > Uploads > Schedules, source
# HTTPS) is protected with these. Leave either empty and the link is switched off.
ADS_EXPORT_USER=
ADS_EXPORT_PASSWORD=

# Google Ads view of /ads-report (?view=google-ads): the Apps Script bridge that reads the report Sheet. The /exec URL
# and its secret token; server side only. Leave either empty and the view says "Google Ads data not connected".
ADS_SHEET_BRIDGE_URL=
ADS_SHEET_BRIDGE_TOKEN=

# Google Ads lead log (scripts/ads-leads-sheet.gs, an Apps Script web app): its /exec URL and secrets; server side only.
# ADS_SHEET_SECRET writes and reads (production). ADS_SHEET_READ_SECRET is the script's READ_SECRET: it can read, never
# write; set it instead of ADS_SHEET_SECRET where the app must only read (Preview). Reads use it when set.
ADS_SHEET_URL=
ADS_SHEET_SECRET=
ADS_SHEET_READ_SECRET=

# Optional page to redirect to after a successful submission. Empty = inline confirmation.
NEXT_PUBLIC_THANK_YOU_URL=

# RIZAL: GTM is the shared best-solution.ae container (GTM-MLFW9XR via the Stape first-party loader),
# fixed in src/components/analytics/GoogleTagManager.tsx. It only loads on best-solution.ae and its
# subdomains (e.g. business.best-solution.ae), so localhost and previews never send data.
# Set to true only to test GTM somewhere else (e.g. a local check in GTM Preview).
NEXT_PUBLIC_ENABLE_GTM=
