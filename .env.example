# Copy to .env.local and fill in before going live.

# ANSHAD: ERPNext connection for calculator leads (creates a Lead via /api/resource/Lead).
# Server-only: the browser posts to /api/lead and these values are never exposed to visitors.
# Leave any of the three empty and the form shows a "not connected yet" message instead of sending.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional Lead Source override. Must already exist in the ERP's "Lead Source" list. Empty = Website.
ERPNEXT_LEAD_SOURCE=

# Optional page to redirect to after a successful submission. Empty = inline confirmation.
NEXT_PUBLIC_THANK_YOU_URL=

# RIZAL: Google Tag Manager container ID, e.g. GTM-XXXXXXX. Empty = GTM is not loaded.
NEXT_PUBLIC_GTM_ID=
